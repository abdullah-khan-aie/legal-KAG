#!/bin/bash
# Bootstrap Lodestone app (FastAPI + KAG) on Amazon Linux 2023.
# Config from Secrets Manager; repo via GitHub deploy key (SSH).
set -euxo pipefail

APP_DIR=/opt/lodestone/app
ENV_FILE=/opt/lodestone/.env
SCAN_DIR="${scan_dir}"
SECRET_ID="${secret_id}"
GITHUB_KEY_SECRET_ID="${github_deploy_key_secret_id}"
APP_PORT="${app_port}"
GIT_REPO="${git_repo_url}"
GIT_REF="${git_ref}"
REGION="${region}"

dnf update -y
dnf install -y git jq openssh-clients

curl -LsSf https://astral.sh/uv/install.sh | sh
export PATH="/root/.local/bin:$PATH"

mkdir -p "$(dirname "$APP_DIR")" /data
for _ in $(seq 1 30); do
  for dev in /dev/nvme1n1 /dev/xvdf /dev/sdf; do
    if [[ -b "$dev" ]]; then
      if ! blkid "$dev" >/dev/null 2>&1; then
        mkfs -t xfs "$dev"
      fi
      mountpoint -q /data || mount "$dev" /data
      grep -q "$dev /data" /etc/fstab || echo "$dev /data xfs defaults,nofail 0 2" >> /etc/fstab
      break 2
    fi
  done
  sleep 2
done
mkdir -p "$SCAN_DIR"
chown -R ec2-user:ec2-user /opt/lodestone /data

setup_github_ssh() {
  [[ -n "$GITHUB_KEY_SECRET_ID" ]] || return 0
  mkdir -p /root/.ssh
  chmod 700 /root/.ssh
  aws secretsmanager get-secret-value \
    --region "$REGION" \
    --secret-id "$GITHUB_KEY_SECRET_ID" \
    --query SecretString --output text > /root/.ssh/id_ed25519
  chmod 600 /root/.ssh/id_ed25519
  ssh-keyscan -t ed25519 github.com >> /root/.ssh/known_hosts 2>/dev/null
  chmod 644 /root/.ssh/known_hosts
  export GIT_SSH_COMMAND="ssh -i /root/.ssh/id_ed25519 -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes"
}

sync_app_repo() {
  if [[ -z "$GIT_REPO" ]]; then
    echo "git_repo_url not set — clone manually to $APP_DIR" >&2
    mkdir -p "$APP_DIR"
    return 0
  fi
  setup_github_ssh
  if [[ ! -d "$APP_DIR/.git" ]]; then
    git clone --branch "$GIT_REF" --single-branch "$GIT_REPO" "$APP_DIR"
  fi
  cd "$APP_DIR"
  git remote set-url origin "$GIT_REPO"
  git fetch origin "$GIT_REF" --depth 1
  git checkout -B "$GIT_REF" "FETCH_HEAD"
  uv sync --frozen 2>/dev/null || uv sync
}

sync_app_repo

cat >"$ENV_FILE" <<EOF
AWS_SECRETS_MANAGER_SECRET_ID=$SECRET_ID
AWS_SECRETS_MANAGER_REGION=$REGION
AWS_REGION=$REGION
EOF

chmod 600 "$ENV_FILE"

cat > /etc/systemd/system/lodestone-app.service <<UNIT
[Unit]
Description=Lodestone FastAPI (KAG ingest + query)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=$APP_DIR
EnvironmentFile=$ENV_FILE
Environment=PATH=/root/.local/bin:/usr/local/bin:/usr/bin
ExecStart=/root/.local/bin/uv run uvicorn src.lodestone.main:app --host 0.0.0.0 --port $APP_PORT
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
if [[ -f "$APP_DIR/pyproject.toml" ]]; then
  systemctl enable --now lodestone-app.service
else
  echo "Skipping lodestone-app.service — no pyproject.toml at $APP_DIR" >&2
fi
