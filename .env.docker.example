# Bootstrap only — LODESTONE_* app config lives in AWS Secrets Manager (lodestone/env).
# Push local values: AWS_PROFILE=sandbox ./infra/scripts/bootstrap_secrets_lodestone.sh
#
# Local Docker: aws sso login --profile sandbox && cp .env.docker.example .env
# Then: docker compose -f docker-compose.yml -f docker-compose.local.yml up -d --build

AWS_SECRETS_MANAGER_SECRET_ID=lodestone/env
AWS_SECRETS_MANAGER_REGION=eu-west-2
AWS_REGION=eu-west-2
AWS_PROFILE=sandbox

LODESTONE_PORT=8080

# Optional: local Neo4j profile (docker compose --profile local)
NEO4J_AUTH=neo4j/test1234
