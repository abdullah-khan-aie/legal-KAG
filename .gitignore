# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual env
.venv/
venv/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Env / secrets
.env
.env.*
!.env.example
.deploy-keys/

# IDE
.DS_Store
.idea/
.vscode/
kag-docs
Best practices for writing code comments - Stack Overflow.pdf
inspection_result

# Local-only reference material (books/PDFs you own; never committed)
reference/
*.pdf

# Ingest corpus is baked into the Docker image (COPY ingest_docs in Dockerfile),
# so it must be tracked -- but ONLY the document types the scanner ingests.
# Everything else that lands in the corpus folders (OOXML extraction scratch,
# corpus build scripts, Office lock/temp files) stays ignored.
ingest_docs/**
!ingest_docs/**/
!ingest_docs/**/*.pdf
!ingest_docs/**/*.docx
!ingest_docs/**/*.xlsx
!ingest_docs/**/*.json
!ingest_docs/**/*.txt
!ingest_docs/**/*.md

# Terraform (state can contain secrets; never commit state or tfvars)
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
!*.tfvars.example
.terraform.lock.hcl
override.tf
override.tf.json
*_override.tf
*_override.tf.json
# evaluation run outputs (not tracked)
eval_results.json
eval_*.json
