# App configuration reference.
#
# IMPORTANT: the application loads ALL * configuration from a single
# AWS Secrets Manager secret. There is deliberately NO .env / environment
# fallback (see src/config/settings.py), so this file is a reference
# for the keys that belong in that secret -- one JSON object whose keys match
# the names below -- rather than a file the app reads directly.
#
# The only real environment variables are the bootstrap ones needed to REACH
# the secret:
#
#   AWS_SECRETS_MANAGER_SECRET_ID=env
#   AWS_SECRETS_MANAGER_REGION=eu-west-2
#
# plus standard AWS credentials (an SSO profile locally, or the EC2 instance
# role in deployment).
#
# Fields without a default are REQUIRED: a missing key fails startup loudly
# rather than silently falling back to a stale value.

# --- Schema -----------------------------------------------------------------
# Local YAML schema ("rulebook") read by the kag SchemaClient.
SCHEMA_PATH=legal_schema.yaml

# --- LLM: Anthropic Claude (direct API) -------------------------------------
# Leave the key unset to fall back to the SDK's ANTHROPIC_API_KEY variable.
ANTHROPIC_API_KEY=sk-ant-...
# Anthropic model id. claude-haiku-4-5 is ~3x cheaper for high-volume ingestion.
LLM_MODEL=claude-sonnet-4-6

# --- Embeddings: Cohere (direct API) ----------------------------------------
# Leave unset to fall back to the SDK's CO_API_KEY variable.
COHERE_API_KEY=...
EMBED_MODEL=embed-v4.0
# "search_document" for ingest; retrieval switches to "search_query" automatically.
EMBED_INPUT_TYPE=search_document
# Embedding length. Also sizes the Neo4j vector indexes, so changing it after
# the indexes exist requires dropping them first.
EMBED_DIMENSION=1536

# --- Neo4j graph store ------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- Graph / indices --------------------------------------------------------
# Label namespace prefix (empty = labels used as-is, e.g. "Contract").
NAMESPACE=app
# Active KAG indices (JSON array). Each entry drives BOTH its ingest extractor
# and its query retriever, so ingestion and retrieval stay in lockstep.
INDEX_LIST=["spo_graph_index","summary_index","chunk_index","atomic_query_index"]

# --- Ingestion --------------------------------------------------------------
# Folder the directory scanner reads. In the container image the corpus is
# copied to /data/ingest, so set that value in a deployed environment.
SCAN_DIR=ingest_docs
# Documents ingested concurrently.
MAX_CONCURRENCY=5
# Global cap on concurrent chunk-extraction tasks, shared across all in-flight
# documents. Each task fans out into several LLM sub-calls, so true in-flight
# calls are a multiple of this.
MODEL_EXECUTE_NUM=100

# --- Logging (stdout only; the platform captures the stream) ----------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# "console" (human-readable, dev) | "json" (production collectors)
LOG_FORMAT=console

# --- Observability: Langfuse tracing + token cost ---------------------------
# OFF by default and a zero-overhead no-op when disabled. When enabled, the
# three Langfuse keys below must be present.
ENABLE_OBSERVABILITY=false
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# Use the host for your Langfuse region (EU and US are separate endpoints).
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Tags traces with the deployment environment.
ENVIRONMENT=dev

# --- Token cost rates (USD per token; REQUIRED) -----------------------------
# Used to compute per-call, per-document and per-run cost in Langfuse.
# Claude Sonnet 4.6 = $3 / $15 per million tokens (values below).
# Claude Haiku 4.5  = $1 / $5  per million -> 0.000001 / 0.000005
LLM_INPUT_COST_PER_TOKEN=0.000003
LLM_OUTPUT_COST_PER_TOKEN=0.000015
# Cohere embedding price per token -- check your Cohere plan.
EMBED_COST_PER_TOKEN=0.00000012
