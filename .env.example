# Ingestion configuration. Copy to `.env` and fill in real values.
# Every variable is prefixed INGEST_ (maps to Settings fields).

# Local schema ("rulebook") read by the kag SchemaClient.
INGEST_SCHEMA_PATH=legal_schema.yaml

# --- LLM: Azure OpenAI (served via kag's AzureOpenAIClient) ---
INGEST_LLM_BASE_URL=https://your-resource.openai.azure.com
INGEST_LLM_API_KEY=
INGEST_LLM_MODEL=gpt-4o
INGEST_LLM_AZURE_DEPLOYMENT=your-deployment-name
INGEST_LLM_API_VERSION=2024-12-01-preview

# --- Embeddings: Azure-hosted Cohere (azure-ai-inference) ---
INGEST_COHERE_ENDPOINT=https://your-cohere-endpoint.models.ai.azure.com
INGEST_COHERE_API_KEY=
INGEST_COHERE_INPUT_TYPE=document

# --- Neo4j graph store ---
# With a password set, the pipeline persists to Neo4j and runs entity linking.
# Leave the password empty to run filter-only (returns the graph in memory).
INGEST_NEO4J_URI=bolt://localhost:7687
INGEST_NEO4J_USER=neo4j
INGEST_NEO4J_PASSWORD=
INGEST_NEO4J_DATABASE=neo4j

# --- Pipeline tuning ---
INGEST_NAMESPACE=

# --- Logging (stdout only; the platform captures and routes the stream) ---
# Level: DEBUG | INFO | WARNING | ERROR | CRITICAL
INGEST_LOG_LEVEL=INFO
# Format: "console" (human-readable, for dev) | "json" (for prod collectors)
INGEST_LOG_FORMAT=console
