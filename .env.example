# Application configuration. Copy to `.env` and fill in real values.
# Every variable is prefixed LODESTONE_ (maps to Settings fields).

# Local schema ("rulebook") read by the kag SchemaClient.
LODESTONE_SCHEMA_PATH=legal_schema.yaml

# --- LLM: Azure OpenAI (v1 API surface) ---
# base_url MUST end in /openai/v1/ ; there is NO api-version on the v1 API.
# LODESTONE_LLM_MODEL is your Azure *deployment name* (passed as `model`).
LODESTONE_LLM_BASE_URL=https://your-resource.openai.azure.com/openai/v1/
LODESTONE_LLM_API_KEY=
LODESTONE_LLM_MODEL=your-deployment-name

# --- Embeddings: Azure-hosted Cohere (azure-ai-inference) ---
LODESTONE_COHERE_ENDPOINT=https://your-cohere-endpoint.models.ai.azure.com
LODESTONE_COHERE_API_KEY=
LODESTONE_COHERE_INPUT_TYPE=document

# --- Neo4j graph store ---
# With a password set, the pipeline persists to Neo4j and runs entity linking.
LODESTONE_NEO4J_URI=bolt://localhost:7687
LODESTONE_NEO4J_USER=neo4j
LODESTONE_NEO4J_PASSWORD=
LODESTONE_NEO4J_DATABASE=neo4j

# --- Pipeline tuning ---
LODESTONE_NAMESPACE=

# Active KAG indices (JSON array). Each drives BOTH its ingest extractor and its
# query retriever. Default builds the typed SPG graph + summary index. Add more
# as you enable them, e.g. '["spo_graph_index","summary_index","chunk_index"]'.
LODESTONE_INDEX_LIST=["spo_graph_index","summary_index"]

# Ingestion: folder the directory scanner reads, and how many documents to
# ingest concurrently (bounded so we don't exceed Azure OpenAI rate limits).
LODESTONE_SCAN_DIR=ingest_docs
LODESTONE_MAX_CONCURRENCY=4

# --- Logging (stdout only; the platform captures and routes the stream) ---
# Level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LODESTONE_LOG_LEVEL=INFO
# Format: "console" (human-readable, for dev) | "json" (for prod collectors)
LODESTONE_LOG_FORMAT=console
